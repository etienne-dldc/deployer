{
  "name": "@dldc/deployer-sdk",
  "version": "0.2.0",
  "private": true,
  "description": "SDK for @dldc/deployer — the code-as-deployment engine for Docker Swarm",
  "keywords": [
    "deployer",
    "deployment",
    "docker",
    "swarm"
  ],
  "homepage": "https://github.com/etienne-dldc/deployer#readme",
  "bugs": {
    "url": "https://github.com/etienne-dldc/deployer/issues"
  },
  "license": "MIT",
  "author": "Etienne Dldc <e.deladonchamps@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etienne-dldc/deployer.git"
  },
  "files": [
    "dist/sdk"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/sdk/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.mts",
      "default": "./dist/sdk/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "directory": "build/npm",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "dev": "tsx watch controller/main.ts",
    "build": "rm -rf dist build && vp pack && pnpm copy:schema && pnpm stage:sdk && pnpm stage:cli",
    "build:sdk": "vp pack -F sdk",
    "build:controller": "vp pack -F controller && pnpm copy:schema",
    "build:cli": "vp pack -F cli",
    "build:harness": "vp pack -F harness",
    "copy:schema": "cp sdk/graph.ts dist/controller/graph.ts",
    "stage:sdk": "tsx scripts/stage-sdk.ts",
    "stage:cli": "tsx scripts/stage-cli.ts",
    "pack:sdk": "pnpm build:sdk && pnpm stage:sdk",
    "pack:cli": "pnpm build:cli && pnpm stage:cli",
    "pack:tarball": "cd build/npm && npm pack",
    "publish:sdk": "pnpm pack:sdk && cd build/npm && npm publish --access public",
    "publish:cli": "pnpm pack:cli && cd build/cli && npm publish --access public",
    "bootstrap:cli": "pnpm pack:cli && cd build/cli && npm pkg set version=0.0.0 && npm publish --access public",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:docker": "DEPLOYER_TEST_DOCKER=1 vp test run integration",
    "base:build": "pnpm build:harness && docker build -f docker/runner-base/Dockerfile -t deployer-runner-base:dev .",
    "docker:build": "docker build -t ghcr.io/etienne-dldc/deployer:dev .",
    "deploy": "tsx cli/main.ts deploy",
    "deployer": "tsx cli/main.ts"
  },
  "devDependencies": {
    "@dldc/ts-api": "^5.0.0",
    "@hono/node-server": "^2.1.5",
    "@types/dockerode": "^4.0.2",
    "@types/node": "^24.0.0",
    "dockerode": "^5.0.1",
    "hono": "^4.13.13",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vite-plus": "^1.1.0",
    "vitest": "^5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.14.0"
}
